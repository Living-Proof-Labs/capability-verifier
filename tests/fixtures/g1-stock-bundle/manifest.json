          "evaluator": "hallway-wall-contact",
          "text": "Never touches a side wall."
        },
        {
          "evaluator": "hallway-fall",
          "text": "Stays upright: the base never drops below the fall height."
        },
        {
          "evaluator": "hallway-lateral-limit",
          "text": "Stays within its lateral limit of the hallway centreline."
        }
      ],
      "grading": "20 runs (seeds 1 to 20), no retries. A configuration passes when at least 18 of 20 runs pass. Results show k/20 with a Wilson 95% interval.",
