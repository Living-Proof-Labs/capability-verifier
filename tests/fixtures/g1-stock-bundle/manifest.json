    "mission": {
      "title": "Walk the hallway",
      "description": "The robot starts at the hallway entrance and is commanded to walk straight ahead at 0.5 m/s. It must reach the exit, 5.5 m along the route, within 27 s, staying upright, never touching either wall, and staying within its lateral limit of the centreline.",
      "success_criteria": [
        {
          "evaluator": "hallway-exit-reached",
          "text": "Reaches the exit, 5.5 m along the route, within 27 s, crossing it inside the exit segment."
