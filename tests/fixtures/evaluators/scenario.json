  "runtime": {"python": "3.12"},
  "entrypoint": {"module": "livingproof_evaluator_scenario"},
  "arguments": [
    "{evidence_manifest}",
    "--thresholds",
    "{thresholds}",
    "--out",
    "{result_dir}"
  ],
  "media": {
